# ---------------------------------------------------------------
# 於 2026-08-14 的安全修復中新增
# ---------------------------------------------------------------

# 實際的連線設定（含資料庫密碼），只提交 api/config.sample.php
/api/config.php

# 應用程式日誌
/db/*.log
/db/app.log

# 使用者上傳的內容不進版本庫
/upload/*
!/upload/.htaccess

# 資料庫傾印：結構檔（db/db21.sql）要進版本庫，
# 但含實際資料的備份不要
/db/backup*.sql
/db/*dump*.sql
/db21.sql

# 編輯器與作業系統產生的檔案
.vscode/
.idea/
Thumbs.db
desktop.ini
*.bak
*.orig
*~
